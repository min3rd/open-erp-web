<div class="flex flex-auto h-full">
  <div class="flex h-full flex-col w-full">
    <!-- Fixed Toolbar -->
    <div class="p-2 border-b border-surface-200 dark:border-surface-700">
      <p-toolbar id="user-list-toolbar">
        <ng-template #start>
          <!-- Scope Toggle -->
          <p-selectButton
            id="user-list-scope-toggle"
            [options]="scopeOptions"
            [(ngModel)]="scope"
            (onChange)="onScopeChange($event.value)"
            [allowEmpty]="false"
            optionLabel="label"
            optionValue="value"
            class="mr-4"
            [attr.aria-label]="'userList.scopeToggle.label' | transloco"
          >
            <ng-template let-item #item>
              <i [class]="item.icon"></i>
              <span class="ml-2">{{ item.label | transloco }}</span>
            </ng-template>
          </p-selectButton>

          <!-- Search Input -->
          <p-inputgroup>
            <p-inputgroup-addon>
              <i class="pi pi-search"></i>
            </p-inputgroup-addon>
            <input
              id="user-list-search"
              type="text"
              pInputText
              [placeholder]="'userList.search.placeholder' | transloco"
              (input)="onSearchChange($event)"
              [value]="searchQuery()"
              class="w-80"
              [attr.aria-label]="'userList.search.label' | transloco"
            />
          </p-inputgroup>
        </ng-template>

        <ng-template #end>
          <!-- Add New Button -->
          <p-button
            id="user-list-add-button"
            icon="pi pi-plus"
            [rounded]="true"
            [text]="true"
            severity="primary"
            (onClick)="onAddUser()"
            [pTooltip]="'userList.addButton.tooltip' | transloco"
            tooltipPosition="bottom"
            [attr.aria-label]="'userList.addButton.label' | transloco"
          />

          <!-- Actions Menu -->
          <p-button
            id="user-list-actions-button"
            icon="pi pi-ellipsis-v"
            [rounded]="true"
            [text]="true"
            (onClick)="menu.toggle($event)"
            [attr.aria-label]="'userList.actionsButton.label' | transloco"
            aria-haspopup="true"
            aria-controls="user-list-actions-menu"
          />
          <p-menu
            #menu
            id="user-list-actions-menu"
            [model]="actionMenuItems"
            [popup]="true"
            appendTo="body"
          />
        </ng-template>
      </p-toolbar>
    </div>

    <!-- Scrollable Content Area -->
    <div id="user-list-content" class="flex-1 overflow-auto">
      <!-- Table -->
      <p-table
        id="user-list-table"
        [value]="users()"
        [(selection)]="selectedUsers"
        [loading]="isLoading()"
        [rowHover]="true"
        dataKey="id"
        styleClass="p-datatable-sm"
        responsiveLayout="scroll"
      >
        <ng-template #header>
          <tr>
            <th class="w-16">
              <p-checkbox
                [ngModel]="allSelected()"
                (onChange)="onToggleSelectAll($event)"
                [binary]="true"
                [attr.aria-label]="'userList.table.selectAll' | transloco"
              />
            </th>
            <th class="w-16">{{ 'userList.table.avatar' | transloco }}</th>
            <th pSortableColumn="fullName">
              {{ 'userList.table.fullName' | transloco }}
              <p-sortIcon field="fullName" />
            </th>
            <th pSortableColumn="email">
              {{ 'userList.table.email' | transloco }}
              <p-sortIcon field="email" />
            </th>
            <th pSortableColumn="phone">
              {{ 'userList.table.phone' | transloco }}
              <p-sortIcon field="phone" />
            </th>
            <th pSortableColumn="status">
              {{ 'userList.table.status' | transloco }}
              <p-sortIcon field="status" />
            </th>
            <th>{{ 'userList.table.lastLogin' | transloco }}</th>
          </tr>
        </ng-template>

        <ng-template #body let-user let-rowIndex="rowIndex">
          <tr
            [id]="'user-list-row-' + user.id"
            (click)="onRowClick(user)"
            (contextmenu)="onRowRightClick($event, user)"
            class="cursor-pointer"
          >
            <td (click)="$event.stopPropagation()">
              <p-checkbox
                [(ngModel)]="selectedUsers"
                [value]="user"
                [binary]="false"
                [attr.aria-label]="('userList.table.selectUser' | transloco) + ' ' + user.fullName"
              />
            </td>
            <td>
              <p-avatar
                [image]="user.avatar"
                [label]="user.fullName.charAt(0)"
                shape="circle"
                size="normal"
              />
            </td>
            <td>
              <div class="font-medium">{{ user.fullName }}</div>
              <div class="text-sm text-surface-500 dark:text-surface-400">@{{ user.username }}</div>
            </td>
            <td>{{ user.email }}</td>
            <td>{{ user.phone || '-' }}</td>
            <td>
              <p-tag
                [value]="user.status | transloco"
                [severity]="getStatusSeverity(user.status)"
              />
            </td>
            <td>{{ formatDate(user.lastLogin || '') }}</td>
          </tr>
        </ng-template>

        <ng-template #empty>
          <tr>
            <td colspan="7" class="text-center py-8 text-surface-500">
              @if (isLoading()) {
              <i class="pi pi-spin pi-spinner text-2xl"></i>
              <p class="mt-2">{{ 'userList.messages.loading' | transloco }}</p>
              } @else if (searchQuery()) {
              <i class="pi pi-search text-2xl"></i>
              <p class="mt-2">
                {{ 'userList.messages.noResults' | transloco : { query: searchQuery() } }}
              </p>
              } @else {
              <i class="pi pi-users text-2xl"></i>
              <p class="mt-2">{{ 'userList.messages.noUsers' | transloco }}</p>
              }
            </td>
          </tr>
        </ng-template>
      </p-table>

      <!-- Context Menu for Row Actions -->
      <p-contextMenu
        #contextMenu
        id="user-list-context-menu"
        [model]="contextMenuItems"
        appendTo="body"
      />
    </div>

    <!-- Fixed Footer with Pagination -->
    <div
      class="border-t border-surface-200 dark:border-surface-700 bg-surface-0 dark:bg-surface-900 p-4"
    >
      <div class="flex items-center justify-between">
        <!-- Pagination -->
        <p-paginator
          id="user-list-pagination"
          [rows]="pageSize()"
          [totalRecords]="totalRecords()"
          [first]="(currentPage() - 1) * pageSize()"
          [rowsPerPageOptions]="[100, 200, 500, 1000]"
          (onPageChange)="onPageChange($event)"
          [showCurrentPageReport]="true"
          [currentPageReportTemplate]="'userList.pagination.report' | transloco"
        />
      </div>
    </div>

    <!-- Screen Reader Status Announcements -->
    <div id="user-list-status" role="status" aria-live="polite" aria-atomic="true" class="sr-only">
      @if (isLoading()) {
      {{ 'userList.messages.loading' | transloco }}
      } @else {
      {{ 'userList.messages.usersLoaded' | transloco : { count: totalRecords() } }}
      }
    </div>
  </div>
  @if(true){
  <div>
    <router-outlet></router-outlet>
  </div>
  }
</div>
